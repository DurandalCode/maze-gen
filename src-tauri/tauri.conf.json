{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maze Lab",
  "version": "0.1.0",
  "identifier": "io.durandal.maze-lab",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Maze Lab", "width": 1440, "height": 960, "minWidth": 920, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": {
      "../examples/bundles/distribution-v2/bundle.json": "maps/bundle.json",
      "../examples/bundles/distribution-v2/manifest.json": "maps/manifest.json",
      "../examples/bundles/distribution-v2/README.md": "maps/README.md"
    }
  }
}
