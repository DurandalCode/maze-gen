{
  "name": "maze-lab-reboot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.core.json && bun scripts/check-imports.ts",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests public index.html *.json *.ts",
    "format:check": "prettier --check src scripts tests public index.html *.json *.ts",
    "build:apk": "bun scripts/build-apk.ts",
    "verify:apk": "bun scripts/verify-apk.ts"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-19",
    "earcut": "3.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/earcut": "3.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "bun-types": "1.4.4",
    "fake-indexeddb": "6.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
